---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { safeRedirectPath } from "@/lib/redirect";

const error = Astro.url.searchParams.get("error");
const redirect = safeRedirectPath(Astro.url.searchParams.get("redirect"));
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <h1
      class="mb-6 bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-center text-4xl font-extrabold tracking-tight text-transparent"
    >
      ToySwapper
    </h1>
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h2
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h2>
      <SignInForm serverError={error} redirect={redirect} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account? <a href="/auth/signup" class="text-purple-300 hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
